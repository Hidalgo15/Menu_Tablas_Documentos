@using System.Globalization
@model Documento
@{
    ViewData["Title"] = "Menú de Documentos";
    // Obtener la lista de documentos y el PDF inicial desde ViewBag
    var documentos = ViewBag.Documentos as List<Documento> ?? new List<Documento>();
    string pdfInicial = ViewBag.PdfUrl as string ?? "";
    string tituloInicial = ViewBag.NombreDocumentoActual as string ?? "Seleccione un documento";

    var categorias = documentos.GroupBy(d => d.Categoria).ToList();

    int codigoPadreActual = ViewContext.RouteData.Values["codigo"] != null
        ? Convert.ToInt32(ViewContext.RouteData.Values["codigo"])
        : (int.TryParse(Context.Request.Query["codigo"], out int c) ? c : 0);

    string nombreTablaActual = ViewContext.RouteData.Values["nombreTabla"]?.ToString()
        ?? Context.Request.Query["nombreTabla"].ToString()
        ?? "";

    var mapaCategorias = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        { "Documento_actividad", "Documentos de Actividades" },
        { "Documento_base", "Documentación Base" },
        { "Documento_propuesta", "Documentos de Propuestas" },
        { "Documentos_mia", "Documentos del MIA" }
    };

    string ObtenerNombreCategoria(string? textoOriginal)
    {
        if (string.IsNullOrWhiteSpace(textoOriginal)) return "Sin Categoría";

        if (mapaCategorias.TryGetValue(textoOriginal, out string? nombrePersonalizado))
        {
            return nombrePersonalizado;
        }

        string limpio = System.Text.RegularExpressions.Regex.Replace(textoOriginal, @"[^a-zA-Z0-9]", " ");
        limpio = System.Text.RegularExpressions.Regex.Replace(limpio, @"\s+", " ").Trim();

        TextInfo textInfo = CultureInfo.CurrentCulture.TextInfo;
        return textInfo.ToTitleCase(limpio.ToLower());
    }
}

<!-- PANTALLA COMPLETA DE BLOQUEO (CAPTCHA) -->
<div id="captchaOverlay" class="position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-75 d-flex align-items-center justify-content-center" style="z-index: 9999; backdrop-filter: blur(5px); transition: opacity 0.5s ease;">
    <div class="card border-0 shadow-lg p-4 rounded-4 text-center bg-white" style="max-width: 420px; width: 90%;">
        <div class="mb-3">
            <i class="bi bi-shield-lock-fill text-primary" style="font-size: 3rem;"></i>
        </div>
        <h4 class="fw-bold text-dark mb-2">Verificación de Seguridad</h4>
        <p class="text-muted small mb-4">Por favor, completa la comprobación de seguridad para acceder al visor de documentos.</p>

        <!-- Contenedor del Turnstile Widget con SiteKey inyectada desde ViewBag -->
        <div class="d-flex justify-content-center mb-3">
            <div class="cf-turnstile"
                 data-sitekey="@ViewBag.TurnstileSiteKey"
                 data-callback="onTurnstileSuccess"
                 data-expired-callback="onTurnstileExpired"></div>
        </div>

        <div id="captchaMessage" class="small text-muted">
            Esperando verificación...
        </div>
    </div>
</div>

<!-- CONTENIDO PRINCIPAL DE LA PÁGINA -->
<div class="container-fluid py-2">
    <div class="row">

        <!-- PANEL IZQUIERDO: Categorías Dinámicas -->
        <div class="col-lg-3 mb-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h5 class="fw-bold mb-0 text-dark">Categorías de Documentos</h5>
                    <small class="text-muted">Seleccione un documento para visualizarlo</small>
                </div>
                <div class="card-body p-2">

                    @if (documentos.Any())
                    {
                        <div class="accordion accordion-flush" id="accordionCategorias">
                            @for (int i = 0; i < categorias.Count; i++)
                            {
                                var grupo = categorias[i];
                                string categoryId = $"cat_{i}";
                                string headingId = $"heading_{i}";
                                string nombreFormateado = ObtenerNombreCategoria(grupo.Key);

                                <div class="accordion-item border rounded-3 mb-2 overflow-visible">
                                    <h2 class="accordion-header" id="@headingId">
                                        <button class="accordion-button fw-bold text-primary"
                                                type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@categoryId"
                                                aria-expanded="true"
                                                aria-controls="@categoryId">
                                            @nombreFormateado
                                        </button>
                                    </h2>

                                    <div id="@categoryId"
                                         class="accordion-collapse collapse show"
                                         aria-labelledby="@headingId">
                                        <div class="accordion-body p-0">
                                            <div class="list-group list-group-flush">
                                                @foreach (var doc in grupo)
                                                {
                                                    string downloadUrl = Url.Action(
                                                    "DescargarDocumento",
                                                    "Documento",
                                                    new
                                                    {
                                                        nombreTabla = nombreTablaActual,
                                                        codigoPadre = codigoPadreActual,
                                                        indiceHijo = doc.Codigo
                                                    }
                                                    )!;

                                                    <button type="button"
                                                            class="list-group-item list-group-item-action d-flex align-items-center doc-item"
                                                            onclick="cargarDocumento('@downloadUrl', '@doc.Nombre', this)">
                                                        <i class="bi bi-file-earmark-pdf me-2 text-danger"></i>
                                                        @doc.Nombre
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <p class="mb-2">
                                <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                            </p>
                            <p class="small">Ingresa una tabla y un código en la URL para cargar documentos</p>
                            <p class="small"><code>https://sistema.url/NombreTabla/123</code></p>
                        </div>
                    }

                </div>
            </div>
        </div>

        <!-- PANEL DERECHO: Visor PDF -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <h5 id="tituloDocumento" class="fw-bold mb-0 text-dark">@tituloInicial</h5>
                    <span class="badge" style="background-color: #0d5493;">Vista Previa</span>
                </div>

                <div class="cgr-pdf-container position-relative overflow-hidden rounded-3" style="height: 140vh; width: 100%;">

                    <!-- OVERLAY DE CARGA DE ARCHIVO -->
                    <div id="pdfLoadingOverlay"
                         class="position-absolute top-0 start-0 w-100 h-100 bg-white d-none flex-column align-items-center justify-content-center"
                         style="z-index: 10;">

                        <div class="spinner-border text-primary mb-3" style="width: 3.5rem; height: 3.5rem;" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>

                        <h6 class="fw-bold text-dark mb-1">Cargando documento...</h6>
                        <p class="text-muted small mb-0">Por favor, espere un momento.</p>
                    </div>

                    <!-- IFRAME DEL VISOR PDF -->
                    <iframe id="pdfFrame"
                            src="@pdfInicial"
                            width="100%"
                            height="100%"
                            style="border: none;">
                        Su navegador no soporta la visualización de documentos PDF.
                    </iframe>

                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <!-- API JS de Cloudflare -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

    <script>
        let currentObjectUrl = null;
        let turnstileToken = null;

        // Callback cuando Cloudflare aprueba al usuario
        function onTurnstileSuccess(token) {
            turnstileToken = token;

            const msg = document.getElementById('captchaMessage');
            msg.className = "small text-success fw-bold";
            msg.innerText = "Verificación correcta. Accediendo...";

            // Ocultar suavemente la pantalla de bloqueo
            const overlay = document.getElementById('captchaOverlay');
            overlay.style.opacity = '0';
            setTimeout(() => {
                overlay.classList.remove('d-flex');
                overlay.classList.add('d-none');

                // AUTOSELECCIONAR Y CARGAR EL PRIMER DOCUMENTO AUTOMÁTICAMENTE
                const primerDocumento = document.querySelector('.doc-item');
                if (primerDocumento) {
                    primerDocumento.click(); // Dispara el evento onclick que invoca cargarDocumento(...)
                }
            }, 500);
        }

        // Callback si el token caduca antes de usarlo
        function onTurnstileExpired() {
            turnstileToken = null;

            const msg = document.getElementById('captchaMessage');
            msg.className = "small text-danger";
            msg.innerText = "La verificación ha caducado. Inténtalo de nuevo.";

            // Volver a mostrar la pantalla de bloqueo si expiró
            const overlay = document.getElementById('captchaOverlay');
            overlay.classList.remove('d-none');
            overlay.classList.add('d-flex');
            overlay.style.opacity = '1';
        }

        async function cargarDocumento(url, titulo, elemento) {
            // Verificar si tenemos el token activo
            if (!turnstileToken) {
                alert("Debes realizar la verificación de seguridad para continuar.");
                location.reload(); // Recarga si el token se perdió o caducó
                return;
            }

            const overlay = document.getElementById('pdfLoadingOverlay');
            const iframe = document.getElementById('pdfFrame');

            // Mostrar pantalla de descarga del documento
            overlay.classList.remove('d-none');
            overlay.classList.add('d-flex');

            document.getElementById('tituloDocumento').innerText = titulo;
            document.querySelectorAll('.doc-item').forEach(item => item.classList.remove('active'));
            elemento.classList.add('active');

            document.getElementById('tituloDocumento').scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });

            try {
                // Enviar la solicitud incluyendo el token en las cabeceras
                const response = await fetch(url, {
                    method: 'GET',
                    headers: {
                        'X-Turnstile-Token': turnstileToken
                    }
                });

                if (!response.ok) {
                    if (response.status === 400 || response.status === 403) {
                        throw new Error('Validación de seguridad expirada. Por favor recargue la página.');
                    }
                    throw new Error('Error al descargar el archivo.');
                }

                const blob = await response.blob();

                if (currentObjectUrl) {
                    URL.revokeObjectURL(currentObjectUrl);
                }

                const pdfBlob = new Blob([blob], { type: 'application/pdf' });
                currentObjectUrl = URL.createObjectURL(pdfBlob);
                iframe.src = currentObjectUrl;

            } catch (error) {
                console.error("Error cargando el PDF:", error);
                alert(error.message || "Ocurrió un error al cargar el documento.");
            } finally {
                overlay.classList.remove('d-flex');
                overlay.classList.add('d-none');
            }
        }
    </script>
}