@using System.Globalization
@model Documento
@{
    ViewData["Title"] = "Menú de Documentos";

    var documentos = ViewBag.Documentos as List<Documento> ?? new List<Documento>();
    string pdfInicial = ViewBag.PdfUrl as string ?? "";
    string tituloInicial = ViewBag.NombreDocumentoActual as string ?? "Seleccione un documento";

    // Agrupación dinámica por Categoría
    var categorias = documentos.GroupBy(d => d.Categoria).ToList();

    // Obtener los valores de la ruta actual
    int codigoPadreActual = ViewContext.RouteData.Values["codigo"] != null
        ? Convert.ToInt32(ViewContext.RouteData.Values["codigo"])
        : (int.TryParse(Context.Request.Query["codigo"], out int c) ? c : 0);

    string nombreTablaActual = ViewContext.RouteData.Values["nombreTabla"]?.ToString()
        ?? Context.Request.Query["nombreTabla"].ToString()
        ?? "";

    // DICCIONARIO DE MAPEO PERSONALIZADO (Nombre en BD >> Nombre en Pantalla)
    var mapaCategorias = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        { "Documento_actividad", "Documentos de Actividades" },
        { "Documento_base", "Documentación Base" },
        { "Documento_propuesta", "Documentos de Propuestas" },
        { "Documentos_mia", "Documentos del MIA" }
    };

    // FUNCIÓN DE FORMATO CON RESPALDO (FALLBACK)
    string ObtenerNombreCategoria(string? textoOriginal)
    {
        if (string.IsNullOrWhiteSpace(textoOriginal)) return "Sin Categoría";

        if (mapaCategorias.TryGetValue(textoOriginal, out string? nombrePersonalizado))
        {
            return nombrePersonalizado;
        }

        string limpio = System.Text.RegularExpressions.Regex.Replace(textoOriginal, @"[^a-zA-Z0-9]", " ");
        limpio = System.Text.RegularExpressions.Regex.Replace(limpio, @"\s+", " ").Trim();

        TextInfo textInfo = CultureInfo.CurrentCulture.TextInfo;
        return textInfo.ToTitleCase(limpio.ToLower());
    }
}

<div class="container-fluid py-2">
    <div class="row">

        <!-- PANEL IZQUIERDO: Categorías Dinámicas -->
        <div class="col-lg-3 mb-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h5 class="fw-bold mb-0 text-dark">Categorías de Documentos</h5>
                    <small class="text-muted">Seleccione un documento para visualizarlo</small>
                </div>
                <div class="card-body p-2">

                    @if (documentos.Any())
                    {
                        <div class="accordion accordion-flush" id="accordionCategorias">
                            @for (int i = 0; i < categorias.Count; i++)
                            {
                                var grupo = categorias[i];
                                string categoryId = $"cat_{i}";
                                string headingId = $"heading_{i}";
                                string nombreFormateado = ObtenerNombreCategoria(grupo.Key);

                                <div class="accordion-item border rounded-3 mb-2 overflow-visible">
                                    <h2 class="accordion-header" id="@headingId">
                                        <button class="accordion-button fw-bold text-primary"
                                                type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@categoryId"
                                                aria-expanded="true"
                                                aria-controls="@categoryId">
                                            @nombreFormateado
                                        </button>
                                    </h2>

                                    <div id="@categoryId"
                                         class="accordion-collapse collapse show"
                                         aria-labelledby="@headingId">
                                        <div class="accordion-body p-0">
                                            <div class="list-group list-group-flush">
                                                @foreach (var doc in grupo)
                                                {
                                                    string downloadUrl = Url.Action(
                                                    "DescargarDocumento",
                                                    "Documento",
                                                    new
                                                    {
                                                        nombreTabla = nombreTablaActual,
                                                        codigoPadre = codigoPadreActual,
                                                        indiceHijo = doc.Codigo
                                                    }
                                                    )!;

                                                    <button type="button"
                                                            class="list-group-item list-group-item-action d-flex align-items-center doc-item"
                                                            onclick="cargarDocumento('@downloadUrl', '@doc.Nombre', this)">
                                                        <i class="bi bi-file-earmark-pdf me-2 text-danger"></i>
                                                        @doc.Nombre
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <p class="mb-2">
                                <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                            </p>
                            <p class="small">Ingresa una tabla y un código en la URL para cargar documentos</p>
                            <p class="small"><code>https://sistema.url/Documento/NombreTabla/123</code></p>
                        </div>
                    }

                </div>
            </div>
        </div>

        <!-- PANEL DERECHO: Visor PDF con Pantalla de Carga -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <h5 id="tituloDocumento" class="fw-bold mb-0 text-dark">@tituloInicial</h5>
                    <span class="badge" style="background-color: #0d5493;">Vista Previa</span>
                </div>

                <!-- Contenedor relativo para posicionar la pantalla de carga encima -->
                <div class="cgr-pdf-container position-relative overflow-hidden rounded-3" style="height: 140vh; width: 100%;">

                    <!-- PANATALLA / OVERLAY DE CARGA -->
                    <div id="pdfLoadingOverlay"
                         class="position-absolute top-0 start-0 w-100 h-100 bg-white d-flex flex-column align-items-center justify-content-center"
                         style="z-index: 10; display: none;">

                        <!-- Opción con Spinner de Bootstrap -->
                        <div class="spinner-border text-primary mb-3" style="width: 3.5rem; height: 3.5rem;" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>

                        <!-- Si prefieres un LOGO o IMAGEN propia, puedes reemplazar el spinner superior por esto:
                        <img src="~/images/logo.png" alt="Cargando..." class="mb-3 spinner-grow p-1" style="max-width: 100px;">
                        -->

                        <h6 class="fw-bold text-dark mb-1">Cargando documento...</h6>
                        <p class="text-muted small mb-0">Por favor, espere un momento.</p>
                    </div>

                    <!-- IFRAME DEL VISOR PDF -->
                    <iframe id="pdfFrame"
                            src="@pdfInicial"
                            width="100%"
                            height="100%"
                            style="border: none;"
                            onload="ocultarLoader()">
                        Su navegador no soporta la visualización de documentos PDF.
                    </iframe>

                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function cargarDocumento(url, titulo, elemento) {
            const overlay = document.getElementById('pdfLoadingOverlay');
            const iframe = document.getElementById('pdfFrame');

            // 1. Mostrar la pantalla de carga
            overlay.style.display = 'flex';

            // 2. Asignar la nueva URL al iframe
            iframe.src = url;
            document.getElementById('tituloDocumento').innerText = titulo;

            // 3. Resaltar elemento activo en la lista
            document.querySelectorAll('.doc-item').forEach(item => {
                item.classList.remove('active');
            });
            elemento.classList.add('active');

            // 4. Hace scroll hasta el contenedor del documento
            document.getElementById('tituloDocumento').scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        }

        // Función invocada por el evento onload="" del iframe cuando termina de cargar
        function ocultarLoader() {
            const overlay = document.getElementById('pdfLoadingOverlay');
            if (overlay) {
                overlay.style.display = 'none';
            }
        }
    </script>
}